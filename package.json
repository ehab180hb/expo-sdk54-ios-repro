{
  "name": "expo-sdk54-todo",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" App.tsx",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" App.tsx",
    "watch": "bash scripts/dev/watch.sh all",
    "dev:watch": "concurrently --names tsc,jest,prettier,metro --kill-others-on-fail \"npm:typecheck -- --watch --preserveWatchOutput\" \"npm:test:watch\" \"prettier --write --watch \\\"**/*.{ts,tsx,json,md,yml}\\\"\" \"npm:start\"",
    "audit:rn": "bash scripts/dev/audit-rn-app.sh",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml}\"",
    "prepare": "lefthook install || true",
    "expo:doctor": "npx --yes expo-doctor",
    "lint:actions": "npx --yes actionlint-cli2"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-native/normalize-colors": "0.81.5",
    "expo": "~56.0.4",
    "expo-build-properties": "^56.0.14",
    "expo-haptics": "^56.0.3",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "^56.0.5",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "~4.1",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-unistyles": "~3.2",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "fast-check": "^4.7.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "lefthook": "^1.7.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-build-properties",
        "expo-haptics",
        "expo-secure-store",
        "expo-web-browser",
        "@react-native-async-storage/async-storage",
        "react-native-safe-area-context"
      ]
    }
  }
}
